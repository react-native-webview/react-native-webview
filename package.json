{
  "name": "react-native-webview-monorepo",
  "private": true,
  "workspaces": [
    "packages/react-native-webview",
    "packages/example-shared",
    "packages/example-mobile"
  ],
  "scripts": {
    "build": "bun run --cwd packages/react-native-webview build",
    "prepare:types": "bun run --cwd packages/react-native-webview prepare:types",
    "prepublishOnly": "bun run --cwd packages/react-native-webview prepublishOnly",
    "ci:publish": "bun run prepublishOnly && npm_config_workspaces_update=false semantic-release",
    "lint:tsc": "tsc --noEmit && tsc --noEmit --project tsconfig.example.json",
    "lint:oxlint": "bun run --bun oxlint",
    "lint:oxlint:ci": "bun run --bun oxlint --format=github",
    "lint:oxfmt": "bun run oxfmt",
    "lint:oxfmt:ci": "bun run oxfmt --check",
    "lint": "bun run lint:tsc && bun run lint:oxlint && bun run lint:oxfmt",
    "lint:ci": "bun run lint:tsc && bun run lint:oxlint:ci && bun run lint:oxfmt:ci",
    "test": "bun run --cwd packages/react-native-webview test",
    "test:windows": "bun run --cwd packages/example-windows test",
    "start": "bun run --cwd packages/example-mobile start",
    "android": "bun run --cwd packages/example-mobile android",
    "ios": "bun run --cwd packages/example-mobile ios",
    "macos": "bun run --cwd packages/example-macos macos",
    "windows": "bun run --cwd packages/example-windows windows",
    "visionos": "bun run --cwd packages/example-visionos visionos"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@rnx-kit/metro-config": "2.2.4",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.6",
    "@semantic-release/npm": "13.1.4",
    "@semantic-release/release-notes-generator": "14.1.0",
    "@types/invariant": "^2.2.37",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.3",
    "jest": "^29.7.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "19.2.7",
    "react-native": "0.87.1",
    "semantic-release": "25.0.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "packageManager": "bun@1.4.1"
}
