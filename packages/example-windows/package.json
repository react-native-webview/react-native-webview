{
  "name": "example-windows",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "windows": "install-windows-test-app --project-directory windows && react-native run-windows --arch x64",
    "test": "jest --setupFiles=./jest-setups/jest.setup.js --runInBand",
    "appium": "appium",
    "bundle": "react-native bundle --platform windows --dev false --entry-file index.js --bundle-output dist/main.windows.bundle --assets-dest dist/assets"
  },
  "dependencies": {
    "example-shared": "file:../example-shared",
    "react": "19.2.3",
    "react-native": "0.84.1",
    "react-native-webview": "file:../react-native-webview"
  },
  "devDependencies": {
    "@react-native-community/cli": "20.2.0",
    "@react-native-windows/find-dotnet-tools": "0.84.0",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/metro-config": "0.84.1",
    "@rnx-kit/metro-config": "2.2.4",
    "@types/selenium-webdriver": "4.0.9",
    "appium": "1.17.0",
    "jest": "^29.7.0",
    "react-native-test-app": "5.4.10",
    "react-native-windows": "0.84.0",
    "selenium-appium": "1.0.2",
    "selenium-webdriver": "4.0.0-alpha.7",
    "winappdriver": "^0.0.7"
  }
}
